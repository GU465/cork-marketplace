{
    "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
    "height": "370",
    "width": "260",
    "hideSelection": false,
    "formatter": {
        "elmType": "div",
        "style": {
            "display": "flex",
            "flex-direction": "column",
            "border-radius": "8px",
            "overflow": "hidden",
            "box-shadow": "0 2px 6px rgba(0,0,0,0.1)",
            "background-color": "#ffffff",
            "height": "100%"
        },
        "children": [
            {
                "elmType": "div",
                "style": {
                    "width": "100%",
                    "height": "150px",
                    "background-color": "#f0f0f0",
                    "overflow": "hidden",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center"
                },
                "children": [
                    {
                        "elmType": "img",
                        "attributes": {
                            "src": "=if([$ImageUrl] != '', [$ImageUrl], '')",
                            "alt": "[$Title]"
                        },
                        "style": {
                            "max-width": "100%",
                            "max-height": "100%",
                            "object-fit": "contain",
                            "display": "=if([$ImageUrl] != '', 'block', 'none')"
                        }
                    },
                    {
                        "elmType": "div",
                        "txtContent": "📷 No photo",
                        "style": {
                            "color": "#999999",
                            "font-size": "14px",
                            "display": "=if([$ImageUrl] == '', 'block', 'none')"
                        }
                    }
                ]
            },
            {
                "elmType": "div",
                "style": {
                    "padding": "10px 12px 12px",
                    "display": "flex",
                    "flex-direction": "column",
                    "flex": "1"
                },
                "children": [
                    {
                        "elmType": "div",
                        "txtContent": "[$Title]",
                        "style": {
                            "font-size": "14px",
                            "font-weight": "600",
                            "color": "#212121",
                            "margin-bottom": "4px",
                            "overflow": "hidden",
                            "text-overflow": "ellipsis",
                            "white-space": "nowrap"
                        }
                    },
                    {
                        "elmType": "div",
                        "txtContent": "[$Description1]",
                        "style": {
                            "font-size": "12px",
                            "color": "#757575",
                            "margin-bottom": "6px",
                            "overflow": "hidden",
                            "text-overflow": "ellipsis",
                            "max-height": "32px"
                        }
                    },
                    {
                        "elmType": "div",
                        "txtContent": "='€' + toString([$SuggestedDonation])",
                        "style": {
                            "font-size": "18px",
                            "font-weight": "700",
                            "color": "#006b70",
                            "margin-bottom": "6px"
                        }
                    },
                    {
                        "elmType": "div",
                        "style": {
                            "display": "flex",
                            "justify-content": "space-between",
                            "align-items": "center",
                            "margin-bottom": "4px"
                        },
                        "children": [
                            {
                                "elmType": "span",
                                "txtContent": "[$Category]",
                                "style": {
                                    "background-color": "#f5f5f5",
                                    "padding": "2px 8px",
                                    "border-radius": "10px",
                                    "font-size": "11px",
                                    "color": "#9e9e9e"
                                }
                            },
                            {
                                "elmType": "span",
                                "txtContent": "='By: ' + [$Author.title]",
                                "style": {
                                    "font-size": "11px",
                                    "color": "#9e9e9e"
                                }
                            }
                        ]
                    },
                    {
                        "elmType": "div",
                        "style": { "flex": "1", "min-height": "4px" }
                    },
                    {
                        "elmType": "div",
                        "txtContent": "='Claimed by ' + [$ClaimedBy.title]",
                        "style": {
                            "font-size": "11px",
                            "color": "#c62828",
                            "margin-bottom": "6px",
                            "font-weight": "500",
                            "display": "=if([$Claimed] == true, 'block', 'none')"
                        }
                    },
                    {
                        "elmType": "button",
                        "txtContent": "✓ Claim Item",
                        "style": {
                            "width": "100%",
                            "padding": "8px",
                            "border": "none",
                            "border-radius": "6px",
                            "font-size": "13px",
                            "font-weight": "600",
                            "cursor": "pointer",
                            "color": "#ffffff",
                            "background-color": "#00a3ad",
                            "display": "=if([$Claimed] == true, 'none', 'block')",
                            "margin-top": "auto"
                        },
                        "customRowAction": {
                            "action": "setValue",
                            "actionInput": {
                                "Claimed": "1",
                                "ClaimedBy": "@me"
                            }
                        }
                    },
                    {
                        "elmType": "div",
                        "txtContent": "❌ No Longer Available",
                        "style": {
                            "width": "100%",
                            "padding": "8px",
                            "border-radius": "6px",
                            "font-size": "12px",
                            "font-weight": "600",
                            "color": "#ffffff",
                            "background-color": "#c62828",
                            "text-align": "center",
                            "display": "=if([$Claimed] == true, 'block', 'none')",
                            "margin-top": "auto"
                        }
                    }
                ]
            }
        ]
    }
}
